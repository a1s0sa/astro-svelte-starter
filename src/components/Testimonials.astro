---
const testimonials = [
  {
    quote:
      'We shipped our landing page in an afternoon. The islands pattern meant our Lighthouse score barely moved as we added features.',
    name: 'Priya Nair',
    role: 'Founder, Loomwork',
  },
  {
    quote:
      'The GSAP setup is the first starter I have used that actually gets ScrollTrigger cleanup right on remount.',
    name: 'Daniel Osei',
    role: 'Frontend Lead, Ferrywell',
  },
  {
    quote:
      'No global store, no state management ceremony. Our form just holds its own state, exactly like a landing page should.',
    name: 'Marta Kowalski',
    role: 'Product Designer, Northbeam',
  },
];
---

<section id="testimonials" class="section section--muted" data-animate-section>
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">
        // testimonials
        <span class="js-badge">0kb js</span>
      </p>
      <h2>Teams ship faster with this starter</h2>
    </div>
    <div class="testimonials-grid">
      {
        testimonials.map((t) => (
          <figure class="testimonials-grid__item" data-animate-item>
            <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption>
              <span class="testimonials-grid__name">{t.name}</span>
              <span class="testimonials-grid__role">{t.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .testimonials-grid__item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 3px solid var(--color-primary);
  }

  blockquote {
    margin: 0;
    color: var(--color-text);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .testimonials-grid__name {
    font-weight: 600;
  }

  .testimonials-grid__role {
    color: var(--color-text-muted);
  }
</style>
